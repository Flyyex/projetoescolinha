# Exemplo de Variaveis de Ambiente para o TRUCKAUTO
PORT=10000
NODE_ENV=production

# Gere uma chave aleatoria (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_AQUI

# Chave de acesso ao Painel Administrador (/admin)
ADMIN_KEY=COLOQUE_UMA_CHAVE_ADMIN_AQUI

# URL publica do seu app (usada no anti-sleep, Telegram e links do CRM)
# Ex: https://seu-app.onrender.com
APP_URL=

# Dados publicos da empresa: WhatsApp, e-mail, dominio, razao social e CNPJ.
# Opcao A (recomendado): copie config/site.json.example para config/site.json e preencha.
# Opcao B: defina as variaveis abaixo -- elas tem prioridade sobre o config/site.json.
#                        config/site.json NAO vai para o git (esta no .gitignore).
SITE_RAZAO_SOCIAL=
SITE_CNPJ=
SITE_RESPONSAVEL=
SITE_EMAIL=
SITE_WHATSAPP=
SITE_WHATSAPP_TEXTO=
SITE_GRUPO_WHATSAPP=
SITE_TELEGRAM=
SITE_INSTAGRAM=
SITE_DOMINIO=

# Conexao com o Banco de Dados PostgreSQL (Render / Supabase / Neon)
# Se deixar vazio, o sistema usa armazenamento em arquivo local (data.json)
# Exemplo Render: postgresql://truckauto_user:SENHA@dpg-xxxxx-a.oregon-postgres.render.com/truckauto
# Exemplo Supabase: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Telegram (Opcional - deixe vazio se nao usar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_CHAT_ID=

# Evolution API / WhatsApp (Opcional - nao configurado por padrao)
EVOLUTION_API_URL=
GLOBAL_API_KEY=
DEFAULT_INSTANCE=

# Cartpanda Pay API (Opcional - caso queira gerar Pix via API direta)
CARTPANDA_API_TOKEN=
CARTPANDA_STORE_SLUG=

# Asaas (https://www.asaas.com) - Cobranca Pix + Saques automaticos via Pix
# Homologacao: crie conta em https://sandbox.asaas.com e gere a API Key
# Producao: ASAAS_ENV=production + API Key de https://www.asaas.com
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token do webhook Asaas (opcional - configure o mesmo valor no painel Asaas > Webhooks)
ASAAS_WEBHOOK_TOKEN=

# MisticPay (https://misticpay.com) - CashIn Pix + Saques automaticos
# Chave de acesso: painel MisticPay > API > Chaves de Acesso (pk_ + sk_)
MISTIC_PK=
MISTIC_SK=

# SyncPay (https://syncpayments.com.br) - CashIn Pix (recebimento)
# Credenciais: painel SyncPay > API (client_id + client_secret)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
# Token do webhook SyncPay (opcional - mesmo valor cadastrado no painel SyncPay > Webhooks)
SYNCPAY_WEBHOOK_TOKEN=